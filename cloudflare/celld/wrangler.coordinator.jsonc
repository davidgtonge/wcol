{
  "name": "wcol-coordinator",
  "main": "coordinator-worker.js",
  "no_bundle": true,
  "compatibility_date": "2026-01-01",
  "durable_objects": {
    "bindings": [
      { "name": "WCOL_COORDINATOR", "class_name": "WcolCoordinator" },
      { "name": "WCOL_NODE", "class_name": "WcolNode", "script_name": "wcol-node" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WcolCoordinator"] }],
  "r2_buckets": [
    { "binding": "OUTPUT", "bucket_name": "wcol-hits-exports" }
  ],
  "vars": {
    "WCOL_FIXED_NODE_POOL": "0",
    "WCOL_MAX_ACTIVE_SCANS": "32",
    "WCOL_MAX_ACTIVE_INGRESS": "32",
    "WCOL_DISPATCH_CONCURRENCY": "2"
  }
}
