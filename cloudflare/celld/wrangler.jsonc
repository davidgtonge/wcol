{
  "name": "wcol-coordinator",
  "main": "entry.ts",
  "compatibility_date": "2026-01-01",
  "durable_objects": {
    "bindings": [
      { "name": "WCOL_COORDINATOR", "class_name": "WcolCoordinator" },
      { "name": "WCOL_NODE", "class_name": "WcolNode" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WcolCoordinator", "WcolNode"] }
  ],
  "r2_buckets": [
    { "binding": "OUTPUT", "bucket_name": "wcol-hits-exports" }
  ],
  "vars": {
    "WCOL_FIXED_NODE_POOL": "0",
    "WCOL_MAX_ACTIVE_SCANS": "1",
    "WCOL_MAX_ACTIVE_INGRESS": "8",
    "WCOL_DISPATCH_CONCURRENCY": "1",
    "WCOL_MAX_NODES": "8",
    "WCOL_NODE_WASM_BUILD": "dev",
    "WCOL_YIELD_AFTER": "8",
    "WCOL_REDUCER_TRACE": "0",
    "WCOL_PHASE_SLOT": "32",
    "WCOL_JOB_TEST_HOOKS": "1",
    "WCOL_JOB_SYNC_MS": "0",
    "WCOL_BUFFER_SCAN_EDGES": "1"
  }
}
