{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "paths": {
      "cloudflare:workers": ["./cloudflare/workers-stub.ts"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "cloudflare/console/**/*.ts", "cloudflare/durable-objects.d.ts"]
}
